# Discord Bot Token
token = your_discord_bot_token

# テストサーバー限定で起動・同期したい場合はサーバーID（数値）を指定してください。カンマ区切りで複数指定も可能です。
# 指定するとグローバルコマンドの同期が停止し、指定したテストサーバーのみに同期されます。
# 指定しない、または 0 の場合は通常起動（全サーバー向け）になります。
Test_server = 0

# ベータ版機能（/information input, /information output, /event等）を提供するサーバーID（数値）を指定してください。カンマ区切りで複数指定も可能です。
# 指定すると、そのサーバーにのみベータ版コマンドがギルドコマンドとして同期されます。
# 指定しない、または 0 の場合はベータ版コマンドは同期されません。
Beta_server = 0

# サポートサーバーのURL
Support_server_url = https://discord.gg/xxxxxxx

